# ==========================================
# Terraform
# ==========================================
# Файлы состояния (содержат ID ресурсов и могут содержать секреты)
*.tfstate
*.tfstate.backup
*.tfstate*

# Кэш провайдеров Terraform
.terraform/

# Файлы переменных (содержат реальные IP, cloud_id, пароли)
*.tfvars
!terraform.tfvars.example

# Ключ сервисного аккаунта Yandex Cloud
key.json

# ==========================================
# Ansible
# ==========================================
# Реальный inventory с IP-адресами
inventory.ini
!inventory.example.ini

# Зашифрованные файлы Vault (содержат пароли)
# (Раскомментируй, если не хочешь хранить даже зашифрованные пароли в Git)
# roles/minio/vars/vault.yml

# Временные файлы Ansible
*.retry

# ==========================================
# Прочее
# ==========================================
# Мусор от macOS
.DS_Store

# Логи
*.log